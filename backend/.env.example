UNIPILE_API_KEY=your_unipile_access_token
UNIPILE_BASE_URL=https://api18.unipile.com:14891
UNIPILE_ACCOUNT_ID=your_linkedin_account_id
DATABASE_URL=postgresql://user:pass@localhost:5432/linkedin_outlier
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/XXX/messages?key=YYY&token=ZZZ
OPENAI_API_KEY=your_openai_api_key
# Optional override — defaults to gpt-image-2. Use gpt-image-1 if your account
# doesn't have access to gpt-image-2 yet.
OPENAI_IMAGE_MODEL=gpt-image-2
